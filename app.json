{
  "expo": {
    "name": "SmartSpend",
    "slug": "smartspend",
    "version": "1.0.0",
    "scheme": "smartspend",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#1B6E3A",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B6E3A"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartspend.app",
      "buildNumber": "1",
      "deploymentTarget": "16.0",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "SmartSpend sends daily reminders to help you log spending and keep your streak alive.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true,
        "NSFaceIDUsageDescription": "Use Face ID to securely access your SmartSpend account."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.smartspend.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B6E3A"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },

    "web": {
      "favicon": "./assets/favicon.png",
      "name": "SmartSpend",
      "shortName": "SmartSpend",
      "description": "Grow strong money habits every day",
      "themeColor": "#1B6E3A",
      "backgroundColor": "#F2FAF4"
    },

    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1B6E3A",
          "sounds": []
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
